# =============================================================================
# .env.docker — Docker deployment environment for PFE Cybersec Platform
# =============================================================================
# Copy to .env.docker and edit values. All secrets MUST come from this file or
# an external secret manager (Vault, AWS Secrets Manager) in production.
# Never commit .env.docker with real secrets — use .env.docker.example.
# =============================================================================

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
APP_NAME="CyberSec Platform"
APP_ENV=production
APP_KEY=base64:PLEASE_RUN_setup_sh_TO_GENERATE
APP_DEBUG=false
APP_URL=http://localhost
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# Frontend
VITE_APP_NAME="CyberSec Platform"

# -----------------------------------------------------------------------------
# Database (PostgreSQL 16)
# -----------------------------------------------------------------------------
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=cybersec
DB_USERNAME=cybersec
DB_PASSWORD=changeme-strong-password
DB_SCHEMA=cybersec
DB_SSLMODE=prefer

# -----------------------------------------------------------------------------
# Redis (queue + cache + sessions)
# -----------------------------------------------------------------------------
REDIS_CLIENT=predis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=changeme-redis-password
REDIS_DB_CACHE=1
REDIS_DB_QUEUE=2
REDIS_DB_SESSION=3

# Cache + Session + Queue
CACHE_STORE=redis
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SAMESITE=lax
SESSION_SECURE_COOKIE=true
QUEUE_CONNECTION=redis

# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------
LOG_CHANNEL=stderr
LOG_STACK=single
LOG_LEVEL=INFO
LOG_DEPRECATIONS_CHANNEL=null
LOG_EXCEPTIONS_CHANNEL=stderr

# -----------------------------------------------------------------------------
# Filesystem
# -----------------------------------------------------------------------------
FILESYSTEM_DISK=local
ASSET_URL=

# -----------------------------------------------------------------------------
# Broadcasting + Mail
# -----------------------------------------------------------------------------
BROADCAST_DRIVER=log
MAIL_MAILER=log

# -----------------------------------------------------------------------------
# Microservice URLs (internal DNS over the cybersec-internal network)
# -----------------------------------------------------------------------------
RECON_SERVICE_URL=http://reconnaissance:5000
SECURITY_SERVICE_URL=http://security:5001
OSINT_SERVICE_URL=http://osint:5002
AI_SERVICE_URL=http://ai:5003
API_GATEWAY_URL=http://api-gateway:8080

# Internal auth token used by the backend to call the Flask services.
# Must match the value set in each service's environment.
SERVICE_MESH_TOKEN=changeme-service-mesh-token
SERVICE_MESH_TIMEOUT=30

# Token used by clients / external callers to authenticate against the
# API Gateway (rate-limited public entry point). setup.sh replaces the
# placeholder with a 32-byte random secret on first run.
API_GATEWAY_TOKEN=changeme-api-gateway-token

# -----------------------------------------------------------------------------
# Ollama (local LLM)
# -----------------------------------------------------------------------------
OLLAMA_HOST=http://ollama:11434
OLLAMA_MODEL=qwen2.5-coder:7b
OLLAMA_KEEP_ALIVE=24h
OLLAMA_TIMEOUT=120

# -----------------------------------------------------------------------------
# Docker socket proxy (sandboxed access — restricted to read-only endpoints)
# -----------------------------------------------------------------------------
# In production, run a socket-proxy container (tecnativa/docker-socket-proxy)
# with ALLOWED_ENDPOINTS=/containers/json,/images/json only.
DOCKER_SOCKET_PROXY=http://socket-proxy:2375
DOCKER_PROXY_READONLY=true

# -----------------------------------------------------------------------------
# RBAC / Authorization (Spatie permission package)
# -----------------------------------------------------------------------------
RBAC_DEFAULT_ROLE=analyst
RBAC_CACHE_TTL=3600
RBAC_SUPER_ADMIN_ROLE=super-admin
RBAC_GUARD=web

# Roles available at install time (comma-separated, lower-case)
RBAC_ROLES=super-admin,auditor,analyst,viewer

# -----------------------------------------------------------------------------
# Rate limiting (per-user, application layer)
# -----------------------------------------------------------------------------
RATE_LIMIT_LOGIN_PER_MIN=5
RATE_LIMIT_API_PER_MIN=60
RATE_LIMIT_SCAN_PER_HOUR=10
RATE_LIMIT_REPORTS_PER_HOUR=30
RATE_LIMIT_AI_PER_HOUR=50

# Throttle configuration for Laravel's ThrottleRequests middleware
THROTTLE_GLOBAL=60,1
THROTTLE_API=60,1

# -----------------------------------------------------------------------------
# Queue configuration (RQ / Laravel queue)
# -----------------------------------------------------------------------------
QUEUE_NAME=default
QUEUE_RETRY_AFTER=90
QUEUE_MAX_TRIES=3
QUEUE_BACKOFF_BASE=5
QUEUE_VISIBILITY_TIMEOUT=60

# Worker tuning
WORKER_CONCURRENCY=2
WORKER_MAX_MEMORY=128
WORKER_TIMEOUT=120

# -----------------------------------------------------------------------------
# Audit logging
# -----------------------------------------------------------------------------
AUDIT_LOG_ENABLED=true
AUDIT_LOG_DRIVER=database
AUDIT_LOG_RETENTION_DAYS=365
AUDIT_LOG_INCLUDE_FAILED=true

# -----------------------------------------------------------------------------
# Security alerts
# -----------------------------------------------------------------------------
SECURITY_ALERT_WEBHOOK=
SECURITY_ALERT_MIN_SEVERITY=medium
SECURITY_ALERT_DEDUP_WINDOW=300

# -----------------------------------------------------------------------------
# Scan engine defaults
# -----------------------------------------------------------------------------
SCAN_DEFAULT_PROFILE=balanced
SCAN_MAX_CONCURRENT=4
SCAN_TIMEOUT_PER_HOST=1800
SCAN_NMAP_DEFAULT_OPTS="-T3 -sV --version-intensity 5"
SCAN_NUCLEI_DEFAULT_OPTS="-severity medium,high,critical"
SCAN_GOBUSTER_DEFAULT_OPTS="-t 30 -to 10s"
SCAN_SUBFINDER_DEFAULT_OPTS="-silent"

# Wordlists (mounted into recon container at /app/wordlists)
WORDLISTS_DIR=/app/wordlists
WORDLIST_SECLISTS=/app/wordlists/SecLists
WORDLIST_COMMON=/app/wordlists/SecLists/Discovery/Web-Content/common.txt
WORDLIST_SUBDOMAINS=/app/wordlists/SecLists/Discovery/DNS/subdomains-top1million-5000.txt

# -----------------------------------------------------------------------------
# CORS
# -----------------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost,http://localhost:80,http://localhost:443
CORS_ALLOWED_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=Content-Type,Authorization,X-Requested-With,X-CSRF-Token
CORS_EXPOSED_HEADERS=Location,X-Total-Count
CORS_MAX_AGE=600
CORS_SUPPORTS_CREDENTIALS=true

# -----------------------------------------------------------------------------
# HTTP server (nginx) — host port mapping
# -----------------------------------------------------------------------------
NGINX_HTTP_PORT=3000
NGINX_HTTPS_PORT=443
BACKEND_DEV_PORT=8000

# TLS / Let's Encrypt (production)
CYBERSEC_DOMAIN=localhost
LETSENCRYPT_EMAIL=admin@localhost
LETSENCRYPT_STAGING=true

# -----------------------------------------------------------------------------
# Container resource hints (informational; actual limits set in compose file)
# -----------------------------------------------------------------------------
MEMORY_LIMIT_BACKEND=1g
MEMORY_LIMIT_RECON=1g
MEMORY_LIMIT_SECURITY=1g
MEMORY_LIMIT_OSINT=512m
MEMORY_LIMIT_AI=1g
MEMORY_LIMIT_API_GATEWAY=256m
MEMORY_LIMIT_WORKER=512m
MEMORY_LIMIT_POSTGRES=1g
MEMORY_LIMIT_REDIS=256m
MEMORY_LIMIT_OLLAMA=4g

# Image tagging
TAG=latest
REGISTRY=ghcr.io
REGISTRY_OWNER=pfe

# -----------------------------------------------------------------------------
# Feature flags
# -----------------------------------------------------------------------------
FEATURE_AI_ENABLED=true
FEATURE_OSINT_ENABLED=true
FEATURE_REMEDIATION_SCRIPTS=true
FEATURE_DEMO_MODE=false
