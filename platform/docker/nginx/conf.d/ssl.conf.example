# =============================================================================
# HTTPS server — enable in production with Let's Encrypt certs
# Mounted at /etc/letsencrypt/live/$DOMAIN/{fullchain,privkey}.pem
# =============================================================================
server {
    listen      443 ssl;
    listen      [::]:443 ssl;
    http2       on;
    server_name ${CYBERSEC_DOMAIN:-localhost};

    ssl_certificate     /etc/letsencrypt/live/${CYBERSEC_DOMAIN:-localhost}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${CYBERSEC_DOMAIN:-localhost}/privkey.pem;

    # HSTS only over HTTPS
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains; preload" always;

    # Re-include same security headers + routes as HTTP server
    include /etc/nginx/snippets/security-headers.conf;
    include /etc/nginx/snippets/routes.conf;
}
